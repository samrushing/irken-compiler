;; -*- Mode: lisp -*-

(stdio
  (includes "stdio.h")
  (structs) ;; note: FILE is an opaque type.
  (constants)
  (lflags)
  (cflags)
  (sigs
   fopen fwrite fread fgetc fclose fflush fdopen putchar getchar
   ;; note: no stdin/stdout/stderr.  their symbols differ by platform
   ;;  (e.g. __stdinp on macOS & FreeBSD), and the compiler needs this
   ;;  interface to be the same everywhere: use fdopen instead.
   ;; variadic
   printf fprintf
   ))



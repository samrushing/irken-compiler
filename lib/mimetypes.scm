;; data borrowed from python"s mimetypes.py

(defmacro mime-rev
  (mime-rev)                       -> (alist:nil)
  (mime-rev (k0 (v0 ...)) kv1 ...) -> (alist:entry k0 (list v0 ...) (alist/make kv1 ...))
  )


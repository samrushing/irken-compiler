(define guess-mime-type
  (let ((m (tree:empty)))
    (for-alist k v mime-rev-alist
      (for-list ext v
	(tree/insert! m string-cmp ext k)))
    (lambda (ext)
      (tree/member m string-cmp ext))
    ))
